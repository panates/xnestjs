{
  "name": "xnestjs",
  "description": "NestJS additional packages",
  "private": true,
  "version": "1.2.0",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/panates/xnestjs.git"
  },
  "workspaces": [
    "packages/*",
    "!packages/*/build"
  ],
  "scripts": {
    "preclean": "rimraf build coverage",
    "clean": "rman run clean",
    "build": "rman run build",
    "lint": "rman run lint",
    "format": "prettier . --write --log-level=warn",
    "test": "mocha",
    "precitest": "rimraf coverage reports",
    "citest": "nyc mocha",
    "qc": "rman run lint && rman run check && rman run compile"
  },
  "devDependencies": {
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/testing": "^12.0.1",
    "@panates/eslint-config": "^2.1.6",
    "@panates/eslint-config-ts": "^2.1.6",
    "@panates/tsconfig": "^2.1.6",
    "@swc-node/register": "^1.12.1",
    "@swc/core": "^1.16.1",
    "@swc/helpers": "^0.5.23",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.4.0",
    "@types/sinon": "^22.0.0",
    "eslint": "^10.9.1",
    "globals": "^17.11.0",
    "dpdm": "^4.3.0",
    "mocha": "^11.8.0",
    "npm-check-updates": "^23.1.0",
    "nyc": "^18.0.0",
    "npm-run-path": "^6.0.0",
    "prettier": "^3.9.6",
    "putil-varhelpers": "^1.7.0",
    "rimraf": "^6.1.3",
    "ts-cleanup": "^1.4.1",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3"
  }
}
